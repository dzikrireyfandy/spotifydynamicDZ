# Spotify Dynamic Island — Konfigurasi
# Salin file ini menjadi .env dan isi dengan data kamu

# === WAJIB DIISI ===
# Buat app di: https://developer.spotify.com/dashboard/
# Klik "Create App", isi nama bebas, set Redirect URI ke: http://127.0.0.1:8888/callback

SPOTIFY_CLIENT_ID=isi_client_id_kamu_di_sini
SPOTIFY_CLIENT_SECRET=isi_client_secret_kamu_di_sini

# === OPSIONAL (default sudah oke) ===
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
